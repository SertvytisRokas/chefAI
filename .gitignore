# Dependencies – do not commit; anyone can run pnpm install
node_modules/

# Next.js build output and cache – regenerated by pnpm run build / pnpm dev
.next/
out/

# Local env with secrets – never push
.env.local
.env*.local

# Optional: keep .env.example committed (no secrets) for documentation
# .env.example

# Debug and logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Vercel
.vercel

# Testing
coverage/
.nyc_output/

# Misc
*.pem
