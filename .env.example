# Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret service role key (server-side only). Keep this secret in production.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider configuration
LLM_MODEL_ENDPOINT=http://localhost:8000/api/generate
LLM_MODEL_NAME=qwen2.5-7b-instruct

# Embedding model configuration (used for RAG)
EMBEDDING_MODEL_ENDPOINT=http://localhost:11434/api/embeddings
EMBEDDING_MODEL_NAME=all-minilm
# The domain of your application (used for auth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000