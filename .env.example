NEXT_PUBLIC_SUPABASE_URL=
# Use either the publishable key or the anon key as provided by Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (single API key for chat + embeddings)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Chat model, e.g. openrouter/owl-alpha
OPENROUTER_CHAT_MODEL=openrouter/owl-alpha
# Embedding model, e.g. qwen/qwen3-embedding-8b
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# --- Kitchen Scribe (cheap model: cook -> fridge deduction resolution) ---
# Small, cheap model. It only resolves recipe ingredients against fridge items
# and reconciles units; it never does the final arithmetic or writes to the DB.
# Swap freely — nothing else depends on which model this is.
OPENROUTER_SCRIBE_MODEL=
# Optional: separate OpenRouter key for the Scribe, so its spend can be tracked
# or capped independently. Leave blank to reuse OPENROUTER_API_KEY.
OPENROUTER_SCRIBE_API_KEY=
# Must match recipe_templates.embedding in Postgres (default 1536)
EMBEDDING_DIMENSIONS=1536

# Public site URL — used for Supabase email confirmation redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
