NEXT_PUBLIC_SUPABASE_URL=
# Use either the publishable key or the anon key as provided by Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter -------------------------------------------------------------
# A *_MODEL variable sets which model runs a job; a *_API_KEY variable sets
# which credential pays for it. All eight are required.
# Keys: https://openrouter.ai/keys   Models: https://openrouter.ai/models

# One model per job. Raw model id, no quotes.
OPENROUTER_RECIPE_MODEL=
OPENROUTER_WEEKLY_MODEL=
OPENROUTER_SCRIBE_MODEL=
OPENROUTER_EMBEDDING_MODEL=

# One key per job.
OPENROUTER_RECIPE_API_KEY=
OPENROUTER_WEEKLY_API_KEY=
OPENROUTER_SCRIBE_API_KEY=
OPENROUTER_EMBEDDING_API_KEY=

# Must match recipe_templates.embedding in Postgres (default 1536)
EMBEDDING_DIMENSIONS=1536

# Public site URL — used for Supabase email confirmation redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
